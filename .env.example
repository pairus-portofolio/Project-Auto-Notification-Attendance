# ============================================================
# .env.example — Template Konfigurasi Monitor Absensi POLBAN
# ============================================================
# PETUNJUK:
#   1. Salin file ini menjadi ".env" (tanpa kata "example")
#   2. Isi setiap nilai sesuai instruksi di bawah
#   3. JANGAN pernah commit file .env ke Git (tambahkan ke .gitignore)
# ============================================================


# ------------------------------------------------------------
# TELEGRAM BOT CONFIGURATION
# ------------------------------------------------------------

# Token Bot Telegram Anda.
# Cara mendapatkan:
#   1. Buka Telegram, cari @BotFather
#   2. Kirim perintah /newbot dan ikuti instruksinya
#   3. BotFather akan memberikan token seperti: 123456789:ABCdef...
TELEGRAM_BOT_TOKEN=MASUKKAN_BOT_TOKEN_ANDA_DI_SINI

# Chat ID tujuan notifikasi (bisa personal atau grup).
# Cara mendapatkan Chat ID pribadi:
#   1. Cari bot @userinfobot di Telegram
#   2. Kirim pesan /start, bot akan balas dengan Chat ID Anda
# Cara mendapatkan Chat ID grup:
#   1. Tambahkan bot Anda ke grup
#   2. Kirim pesan di grup, lalu kunjungi:
#      https://api.telegram.org/bot<TOKEN>/getUpdates
#   3. Cari nilai "chat.id" (angka negatif untuk grup, misal: -1001234567890)
TELEGRAM_CHAT_ID=MASUKKAN_CHAT_ID_ANDA_DI_SINI


# ------------------------------------------------------------
# COOKIE SESI PORTAL AKADEMIK
# ------------------------------------------------------------

# Nilai cookie "akad_session" dari browser Anda.
# Cara mendapatkan:
#   1. Login ke https://akademik.polban.ac.id
#   2. Buka Developer Tools (F12) → tab Application/Storage
#   3. Klik Cookies → pilih akademik.polban.ac.id
#   4. Salin nilai kolom "Value" dari baris "akad_session"
#
# PENTING: Cookie ini memiliki masa berlaku terbatas.
#   Jika script melaporkan "sesi kedaluwarsa", ulangi langkah di atas
#   dan perbarui nilai di bawah ini.
COOKIE_AKAD_SESSION=MASUKKAN_NILAI_COOKIE_AKAD_SESSION_DI_SINI


# ------------------------------------------------------------
# USER-AGENT (Opsional)
# ------------------------------------------------------------

# User-Agent browser yang digunakan saat request ke server.
# Biarkan kosong untuk menggunakan nilai default (Chrome Windows).
# Salin dari Developer Tools → tab Network → klik request → Headers → User-Agent
USER_AGENT=


# ------------------------------------------------------------
# PENGATURAN POLLING (Opsional)
# ------------------------------------------------------------

# Interval pengecekan dalam detik (default: 60)
# Nilai minimum yang disarankan: 30 detik (menghormati server kampus)
POLL_INTERVAL_SECONDS=60

# Level log: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Kirim pesan konfirmasi ke Telegram saat script pertama kali dijalankan?
# true = ya, false = tidak (default: true)
SEND_STARTUP_MESSAGE=true
